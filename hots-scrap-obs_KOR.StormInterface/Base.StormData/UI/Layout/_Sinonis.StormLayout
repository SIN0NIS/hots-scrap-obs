<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Desc>
	<!-- Sinonis additions on top of Ahli Obs UI -->

	<!-- one row of the Sinonis menu: checkbox + label, hotkey goes on Button/Shortcut -->
	<Frame type="CheckBox" name="SinonisMenuRowTemplate" template="StandardTemplates/StandardCheckBoxLabelTemplate">
		<Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
		<Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
		<Height val="38"/>
		<Muted val="true"/>
		<Frame type="Label" name="Label">
			<Style val="@AhliFeatureControl"/>
		</Frame>
	</Frame>

	<Frame type="GameUI" name="GameUI" file="GameUI">

		<!-- state frames: visible = feature active. Health bar / name labels bind to these handles. -->
		<Frame type="Frame" name="SinonisHpCurState">
			<Anchor relative="$parent"/>
			<Visible val="true"/>
			<Handle val="SINONIS_HP_CUR_STATE"/>
		</Frame>
		<Frame type="Frame" name="SinonisHpMaxState">
			<Anchor relative="$parent"/>
			<Visible val="true"/>
			<Handle val="SINONIS_HP_MAX_STATE"/>
		</Frame>
		<Frame type="Frame" name="SinonisHpPctState">
			<Anchor relative="$parent"/>
			<Visible val="true"/>
			<Handle val="SINONIS_HP_PCT"/>
		</Frame>
		<Frame type="Frame" name="SinonisHpShieldState">
			<Anchor relative="$parent"/>
			<Visible val="true"/>
			<Handle val="SINONIS_HP_SHIELD"/>
		</Frame>
		<Frame type="Frame" name="SinonisNamesState">
			<Anchor relative="$parent"/>
			<Visible val="true"/>
			<Handle val="PLAYER_NAME_TOGGLE_STATE"/>
		</Frame>
		<!-- name mode: the core bar drives SINONIS_NAMES_ON / SINONIS_HERO_NAME_MODE, this group decides between
			the player-name label (PLAYER_NAME_TOGGLE_STATE) and the hero-name label (SINONIS_HERO_NAME_SHOW) -->
		<Frame type="Frame" name="SinonisNamesOnState">
			<Anchor relative="$parent"/>
			<Visible val="true"/>
			<Handle val="SINONIS_NAMES_ON"/>
		</Frame>
		<Frame type="Frame" name="SinonisHeroNameModeState">
			<Anchor relative="$parent"/>
			<Visible val="false"/>
			<Handle val="SINONIS_HERO_NAME_MODE"/>
		</Frame>
		<Frame type="Frame" name="SinonisHeroNameShowState">
			<Anchor relative="$parent"/>
			<Visible val="false"/>
			<Handle val="SINONIS_HERO_NAME_SHOW"/>
		</Frame>
		<StateGroup name="SinonisNameMode">
			<DefaultState val="None"/>
			<State name="Hero">
				<When type="Property" frame="SinonisNamesOnState" visible="true"/>
				<When type="Property" frame="SinonisHeroNameModeState" visible="true"/>
				<Action type="SetProperty" frame="SinonisNamesState" visible="false"/>
				<Action type="SetProperty" frame="SinonisHeroNameShowState" visible="true"/>
			</State>
			<State name="Player">
				<When type="Property" frame="SinonisNamesOnState" visible="true"/>
				<Action type="SetProperty" frame="SinonisNamesState" visible="true"/>
				<Action type="SetProperty" frame="SinonisHeroNameShowState" visible="false"/>
			</State>
			<State name="None">
				<Action type="SetProperty" frame="SinonisNamesState" visible="false"/>
				<Action type="SetProperty" frame="SinonisHeroNameShowState" visible="false"/>
			</State>
		</StateGroup>
		<!-- current/max needs both toggles, so it is resolved here instead of in every health bar -->
		<Frame type="Frame" name="SinonisHpCurOnlyState">
			<Anchor relative="$parent"/>
			<Visible val="false"/>
			<Handle val="SINONIS_HP_CUR_ONLY"/>
		</Frame>
		<Frame type="Frame" name="SinonisHpCurMaxState">
			<Anchor relative="$parent"/>
			<Visible val="false"/>
			<Handle val="SINONIS_HP_CUR_MAX"/>
		</Frame>
		<!-- with percent on, everything sits in the bar as "value (pct%)"; _S = split layout, _C = centred alone -->
		<Frame type="Frame" name="SinonisHpCurOnlySplitState">
			<Anchor relative="$parent"/>
			<Visible val="false"/>
			<Handle val="SINONIS_HP_CUR_ONLY_S"/>
		</Frame>
		<Frame type="Frame" name="SinonisHpCurMaxSplitState">
			<Anchor relative="$parent"/>
			<Visible val="false"/>
			<Handle val="SINONIS_HP_CUR_MAX_S"/>
		</Frame>
		<Frame type="Frame" name="SinonisHpPctCentreState">
			<Anchor relative="$parent"/>
			<Visible val="false"/>
			<Handle val="SINONIS_HP_PCT_C"/>
		</Frame>
		<Frame type="Frame" name="SinonisHpPctSplitState">
			<Anchor relative="$parent"/>
			<Visible val="false"/>
			<Handle val="SINONIS_HP_PCT_S"/>
		</Frame>
		<Frame type="Frame" name="SinonisHpPctSplitMaxState">
			<Anchor relative="$parent"/>
			<Visible val="false"/>
			<Handle val="SINONIS_HP_PCT_S2"/>
		</Frame>
		<StateGroup name="SinonisHpMode">
			<DefaultState val="None"/>
			<!-- first matching state wins; every state sets all seven outputs instead of relying on undo.
				max alone means nothing without the current value, so it shows current/max. -->
			<State name="CurMaxPct">
				<When type="Property" frame="SinonisHpMaxState" visible="true"/>
				<When type="Property" frame="SinonisHpPctState" visible="true"/>
				<Action type="SetProperty" frame="SinonisHpCurOnlyState" visible="false"/>
				<Action type="SetProperty" frame="SinonisHpCurMaxState" visible="false"/>
				<Action type="SetProperty" frame="SinonisHpCurOnlySplitState" visible="false"/>
				<Action type="SetProperty" frame="SinonisHpCurMaxSplitState" visible="true"/>
				<Action type="SetProperty" frame="SinonisHpPctCentreState" visible="false"/>
				<Action type="SetProperty" frame="SinonisHpPctSplitState" visible="false"/>
				<Action type="SetProperty" frame="SinonisHpPctSplitMaxState" visible="true"/>
			</State>
			<State name="CurPct">
				<When type="Property" frame="SinonisHpCurState" visible="true"/>
				<When type="Property" frame="SinonisHpPctState" visible="true"/>
				<Action type="SetProperty" frame="SinonisHpCurOnlyState" visible="false"/>
				<Action type="SetProperty" frame="SinonisHpCurMaxState" visible="false"/>
				<Action type="SetProperty" frame="SinonisHpCurOnlySplitState" visible="true"/>
				<Action type="SetProperty" frame="SinonisHpCurMaxSplitState" visible="false"/>
				<Action type="SetProperty" frame="SinonisHpPctCentreState" visible="false"/>
				<Action type="SetProperty" frame="SinonisHpPctSplitState" visible="true"/>
				<Action type="SetProperty" frame="SinonisHpPctSplitMaxState" visible="false"/>
			</State>
			<State name="Pct">
				<When type="Property" frame="SinonisHpPctState" visible="true"/>
				<Action type="SetProperty" frame="SinonisHpCurOnlyState" visible="false"/>
				<Action type="SetProperty" frame="SinonisHpCurMaxState" visible="false"/>
				<Action type="SetProperty" frame="SinonisHpCurOnlySplitState" visible="false"/>
				<Action type="SetProperty" frame="SinonisHpCurMaxSplitState" visible="false"/>
				<Action type="SetProperty" frame="SinonisHpPctCentreState" visible="true"/>
				<Action type="SetProperty" frame="SinonisHpPctSplitState" visible="false"/>
				<Action type="SetProperty" frame="SinonisHpPctSplitMaxState" visible="false"/>
			</State>
			<State name="Max">
				<When type="Property" frame="SinonisHpMaxState" visible="true"/>
				<Action type="SetProperty" frame="SinonisHpCurOnlyState" visible="false"/>
				<Action type="SetProperty" frame="SinonisHpCurMaxState" visible="true"/>
				<Action type="SetProperty" frame="SinonisHpCurOnlySplitState" visible="false"/>
				<Action type="SetProperty" frame="SinonisHpCurMaxSplitState" visible="false"/>
				<Action type="SetProperty" frame="SinonisHpPctCentreState" visible="false"/>
				<Action type="SetProperty" frame="SinonisHpPctSplitState" visible="false"/>
				<Action type="SetProperty" frame="SinonisHpPctSplitMaxState" visible="false"/>
			</State>
			<State name="Cur">
				<When type="Property" frame="SinonisHpCurState" visible="true"/>
				<Action type="SetProperty" frame="SinonisHpCurOnlyState" visible="true"/>
				<Action type="SetProperty" frame="SinonisHpCurMaxState" visible="false"/>
				<Action type="SetProperty" frame="SinonisHpCurOnlySplitState" visible="false"/>
				<Action type="SetProperty" frame="SinonisHpCurMaxSplitState" visible="false"/>
				<Action type="SetProperty" frame="SinonisHpPctCentreState" visible="false"/>
				<Action type="SetProperty" frame="SinonisHpPctSplitState" visible="false"/>
				<Action type="SetProperty" frame="SinonisHpPctSplitMaxState" visible="false"/>
			</State>
			<State name="None">
				<Action type="SetProperty" frame="SinonisHpCurOnlyState" visible="false"/>
				<Action type="SetProperty" frame="SinonisHpCurMaxState" visible="false"/>
				<Action type="SetProperty" frame="SinonisHpCurOnlySplitState" visible="false"/>
				<Action type="SetProperty" frame="SinonisHpCurMaxSplitState" visible="false"/>
				<Action type="SetProperty" frame="SinonisHpPctCentreState" visible="false"/>
				<Action type="SetProperty" frame="SinonisHpPctSplitState" visible="false"/>
				<Action type="SetProperty" frame="SinonisHpPctSplitMaxState" visible="false"/>
			</State>
		</StateGroup>

		<!-- the Sinonis menu hotkey now drives ToggleAllUI, so drop Ahli's own shortcut on it -->
		<Frame type="ToggleControl" name="ToggleAllUI">
			<Shortcut val=""/>
		</Frame>

		<!-- "Toggle all UI" only shifted UIContainer away, which left the top bar and minimap on screen in replays.
			Hide the whole container outright as well. -->
		<Animation name="SinonisAllUiHide">
			<Event event="HideAll" action="DirectionForward,Play"/>
			<Event event="ShowAll" action="DirectionReverse,Play"/>
			<Controller type="Visibility" end="Pause" frame="UIContainer">
				<Key type="Bool" time="0" value="true"/>
				<Key type="Bool" time="0.01" value="false"/>
			</Controller>
		</Animation>

		<!-- the only always-on control: a small semi-transparent [메뉴] box in the top-left corner, kept narrow so it
			does not cover the top bar. Lives outside UIContainer, so it survives "UI 전체" off and the UI can
			always be brought back from the menu. -->
		<Frame type="CheckBox" name="SinonisMenuButton" template="_Sinonis/SinonisMenuRowTemplate">
			<Anchor side="Top" relative="$parent" pos="Min" offset="4"/>
			<Anchor side="Left" relative="$parent" pos="Min" offset="4"/>
			<Anchor side="Right" relative="$parent" pos="Min" offset="136"/>
			<Height val="28"/>
			<RenderPriority val="900"/>
			<Alpha val="190"/>
			<Tooltip val="@Sinonis/MenuTooltip"/>
			<Frame type="Image" name="Background">
				<Anchor side="Top" relative="$parent" pos="Min" offset="-2"/>
				<Anchor side="Bottom" relative="$parent" pos="Max" offset="2"/>
				<Anchor side="Left" relative="$parent" pos="Min" offset="-2"/>
				<Anchor side="Right" relative="$parent" pos="Max" offset="2"/>
				<TextureType val="Normal"/>
				<Texture val="@UI/Storm_Generic_Background_Low"/>
				<RenderPriority val="400"/>
				<AcceptsMouse val="false"/>
			</Frame>
			<Frame type="Button" name="Button">
				<Anchor side="Top" relative="$parent" pos="Min" offset="2"/>
				<Anchor side="Left" relative="$parent" pos="Min" offset="4"/>
				<Width val="24"/>
				<Height val="24"/>
				<Shortcut val="#Hotkey - Toggle Sinonis Menu"/>
			</Frame>
			<Frame type="Image" name="CheckImage">
				<!-- open: slide the panel on screen; closed: park it far off screen (kept visible so its hotkeys keep working) -->
				<Animation name="SinonisMenuOpen">
					<Event event="OnShown" action="DirectionForward,Play"/>
					<Event event="OnHidden" action="DirectionReverse,Play"/>
					<Controller type="Anchor" end="Pause" side="Left" relative="true" frame="$parent/$parent/SinonisMenuPanel">
						<Key type="Curve" time="0" value="0" inout="Fast"/>
						<Key type="Curve" time="0.01" value="10000" inout="Fast"/>
					</Controller>
				</Animation>
			</Frame>
			<Frame type="Label" name="Label">
				<Style val="SinonisCoreBarLabel"/>
				<Text val="@Sinonis/QuickMenu"/>
			</Frame>
			<!-- checkbox · 메뉴 · hotkey -->
			<Frame type="Label" name="Key">
				<Anchor side="Top" relative="$parent/Button" pos="Min" offset="0"/>
				<Anchor side="Bottom" relative="$parent/Button" pos="Max" offset="0"/>
				<Anchor side="Right" relative="$parent" pos="Max" offset="-4"/>
				<Width val="70"/>
				<Style val="SinonisMenuKeyLabel"/>
				<Text val="Ctrl+Alt+O"/>
				<AcceptsMouse val="false"/>
			</Frame>
		</Frame>

		<!-- the [메뉴] panel: the switches used while watching. Every box starts empty (Toggled is ignored in
			replays): empty = default, tick = changed. Rows whose default is "shown" draw ShownMark while empty,
			so on screen a tick still means "shown". Generated by tools/core_bar.py - edit there. -->
		<Frame type="Frame" name="SinonisMenuPanel">
			<Anchor side="Top" relative="$parent/SinonisMenuButton" pos="Max" offset="4"/>
			<Anchor side="Left" relative="$parent" pos="Min" offset="-9994"/>
			<Width val="310"/>
			<Height val="1058"/>
			<RenderPriority val="900"/>

			<Frame type="Image" name="LowImage">
				<Anchor relative="$parent"/>
				<TextureType val="Normal"/>
				<Texture val="@UI/Storm_Generic_Background_Low"/>
				<Alpha val="215"/>
			</Frame>

			<Frame type="Label" name="Title">
				<Anchor side="Top" relative="$parent" pos="Min" offset="8"/>
				<Anchor side="Left" relative="$parent" pos="Min" offset="12"/>
				<Anchor side="Right" relative="$parent" pos="Max" offset="-12"/>
				<Style val="AhliControlsHeader"/>
				<Text val="@Sinonis/MenuTitle"/>
			</Frame>

			<Frame type="Frame" name="SinonisTopTalentsState">
				<Anchor relative="$parent"/>
				<Visible val="false"/>
				<Handle val="SINONIS_TOP_TALENTS"/>
			</Frame>
			<Frame type="Frame" name="SinonisTopHeroicState">
				<Anchor relative="$parent"/>
				<Visible val="true"/>
				<Handle val="SINONIS_TOP_HEROIC"/>
			</Frame>
			<Frame type="Frame" name="SinonisTopHeroesState">
				<Anchor relative="$parent"/>
				<Visible val="true"/>
				<Handle val="SINONIS_TOP_HEROES"/>
			</Frame>
			<Frame type="Frame" name="SinonisTopManaState">
				<Anchor relative="$parent"/>
				<Visible val="true"/>
				<Handle val="SINONIS_TOP_MANA"/>
			</Frame>
			<Frame type="Frame" name="SinonisTopSkills1State">
				<Anchor relative="$parent"/>
				<Visible val="false"/>
				<Handle val="SINONIS_TOP_SKILLS1"/>
			</Frame>
			<Frame type="Frame" name="SinonisTopSkills2State">
				<Anchor relative="$parent"/>
				<Visible val="false"/>
				<Handle val="SINONIS_TOP_SKILLS2"/>
			</Frame>
			<Frame type="Frame" name="SinonisTopAhliStripState">
				<Anchor relative="$parent"/>
				<Visible val="true"/>
				<Handle val="SINONIS_TOP_AHLISTRIP"/>
			</Frame>
			<Frame type="Label" name="Head7">
				<Anchor side="Top" relative="$parent" pos="Min" offset="48"/>
				<Anchor side="Left" relative="$parent" pos="Min" offset="12"/>
				<Anchor side="Right" relative="$parent" pos="Max" offset="-12"/>
				<Height val="22"/>
				<Style val="SinonisMenuHeadLabel"/>
				<Text val="@Sinonis/Menu/Head7"/>
			</Frame>
			<Frame type="CheckBox" name="MenuAllUI" template="_Sinonis/SinonisMenuRowTemplate">
				<Anchor side="Top" relative="$parent" pos="Min" offset="70"/>
				<Anchor side="Left" relative="$parent" pos="Min" offset="20"/>
				<Anchor side="Right" relative="$parent" pos="Max" offset="-12"/>
				<Height val="26"/>
				<Toggled val="false"/>
				<Tooltip val="@Sinonis/Menu/Tip/AllUI"/>
				<Frame type="Button" name="Button">
					<Width val="22"/>
					<Height val="22"/>
					<Shortcut val="#Hotkey - Toggle all UI"/>
				</Frame>
				<Frame type="Image" name="ShownMark">
					<Anchor relative="$parent/Button"/>
					<Texture val="@UI/Storm_Checkbox_CheckMark"/>
					<AcceptsMouse val="false"/>
				</Frame>
				<Frame type="Image" name="CheckImage">
					<Alpha val="0"/>
					<Animation name="Apply">
						<Event event="OnShown" action="DirectionForward,Play"/>
						<Event event="OnHidden" action="DirectionReverse,Play"/>
						<Controller type="Visibility" end="Pause" frame="$ToggleAllUI">
							<Key type="Bool" time="0" value="false"/>
							<Key type="Bool" time="0.01" value="true"/>
						</Controller>
						<Controller type="Visibility" end="Pause" frame="$parent/ShownMark">
							<Key type="Bool" time="0" value="true"/>
							<Key type="Bool" time="0.01" value="false"/>
						</Controller>
					</Animation>
				</Frame>
				<Frame type="Label" name="Label">
					<Style val="SinonisCoreBarLabel"/>
					<Text val="@Sinonis/Menu/AllUI"/>
				</Frame>
				<Frame type="Label" name="Key">
					<Anchor side="Top" relative="$parent/Button" pos="Min" offset="0"/>
					<Anchor side="Bottom" relative="$parent/Button" pos="Max" offset="0"/>
					<Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
					<Width val="80"/>
					<Style val="SinonisMenuKeyLabel"/>
					<Text val="Ctrl+Alt+U"/>
					<AcceptsMouse val="false"/>
				</Frame>
			</Frame>
			<Frame type="CheckBox" name="MenuTop" template="_Sinonis/SinonisMenuRowTemplate">
				<Anchor side="Top" relative="$parent" pos="Min" offset="98"/>
				<Anchor side="Left" relative="$parent" pos="Min" offset="20"/>
				<Anchor side="Right" relative="$parent" pos="Max" offset="-12"/>
				<Height val="26"/>
				<Toggled val="false"/>
				<Tooltip val="@Sinonis/Menu/Tip/Top"/>
				<Frame type="Button" name="Button">
					<Width val="22"/>
					<Height val="22"/>
				</Frame>
				<Frame type="Image" name="ShownMark">
					<Anchor relative="$parent/Button"/>
					<Texture val="@UI/Storm_Checkbox_CheckMark"/>
					<AcceptsMouse val="false"/>
				</Frame>
				<Frame type="Image" name="CheckImage">
					<Alpha val="0"/>
					<Animation name="Apply">
						<Event event="OnShown" action="DirectionForward,Play"/>
						<Event event="OnHidden" action="DirectionReverse,Play"/>
						<Controller type="Fade" end="Pause" frame="$parent/$parent/$parent/UIContainer/FullscreenUpperContainer/ObserverHeroOverviewPanel">
							<Key type="Curve" time="0" value="255"/>
							<Key type="Curve" time="0.01" value="0"/>
						</Controller>
						<Controller type="Fade" end="Pause" frame="$parent/$parent/$parent/UIContainer/FullscreenUpperContainer/TeamPanel">
							<Key type="Curve" time="0" value="255"/>
							<Key type="Curve" time="0.01" value="0"/>
						</Controller>
						<Controller type="Fade" end="Pause" frame="$LeftTeamXpBar">
							<Key type="Curve" time="0" value="255"/>
							<Key type="Curve" time="0.01" value="0"/>
						</Controller>
						<Controller type="Fade" end="Pause" frame="$RightTeamXpBar">
							<Key type="Curve" time="0" value="255"/>
							<Key type="Curve" time="0.01" value="0"/>
						</Controller>
						<Controller type="Fade" end="Pause" frame="$parent/$parent/$parent/UIContainer/FullscreenUpperContainer/TimePanel">
							<Key type="Curve" time="0" value="255"/>
							<Key type="Curve" time="0.01" value="0"/>
						</Controller>
						<Controller type="Fade" end="Pause" frame="$parent/$parent/$parent/UIContainer/FullscreenUpperContainer/ObserverTeamNamePanel">
							<Key type="Curve" time="0" value="255"/>
							<Key type="Curve" time="0.01" value="0"/>
						</Controller>
						<Controller type="Visibility" end="Pause" frame="$parent/ShownMark">
							<Key type="Bool" time="0" value="true"/>
							<Key type="Bool" time="0.01" value="false"/>
						</Controller>
					</Animation>
				</Frame>
				<Frame type="Label" name="Label">
					<Style val="SinonisCoreBarLabel"/>
					<Text val="@Sinonis/Menu/Top"/>
				</Frame>
			</Frame>
			<Frame type="CheckBox" name="MenuMinimap" template="_Sinonis/SinonisMenuRowTemplate">
				<Anchor side="Top" relative="$parent" pos="Min" offset="126"/>
				<Anchor side="Left" relative="$parent" pos="Min" offset="20"/>
				<Anchor side="Right" relative="$parent" pos="Max" offset="-12"/>
				<Height val="26"/>
				<Toggled val="false"/>
				<Tooltip val="@Sinonis/Menu/Tip/Minimap"/>
				<Frame type="Button" name="Button">
					<Width val="22"/>
					<Height val="22"/>
				</Frame>
				<Frame type="Image" name="ShownMark">
					<Anchor relative="$parent/Button"/>
					<Texture val="@UI/Storm_Checkbox_CheckMark"/>
					<AcceptsMouse val="false"/>
				</Frame>
				<Frame type="Image" name="CheckImage">
					<Alpha val="0"/>
					<Animation name="Apply">
						<Event event="OnShown" action="DirectionForward,Play"/>
						<Event event="OnHidden" action="DirectionReverse,Play"/>
						<Controller type="Fade" end="Pause" frame="$parent/$parent/$parent/UIContainer/ConsoleUIContainer/MinimapPanel">
							<Key type="Curve" time="0" value="255"/>
							<Key type="Curve" time="0.01" value="0"/>
						</Controller>
						<Controller type="Visibility" end="Pause" frame="$parent/ShownMark">
							<Key type="Bool" time="0" value="true"/>
							<Key type="Bool" time="0.01" value="false"/>
						</Controller>
					</Animation>
				</Frame>
				<Frame type="Label" name="Label">
					<Style val="SinonisCoreBarLabel"/>
					<Text val="@Sinonis/Menu/Minimap"/>
				</Frame>
			</Frame>
			<Frame type="CheckBox" name="MenuChat" template="_Sinonis/SinonisMenuRowTemplate">
				<Anchor side="Top" relative="$parent" pos="Min" offset="154"/>
				<Anchor side="Left" relative="$parent" pos="Min" offset="20"/>
				<Anchor side="Right" relative="$parent" pos="Max" offset="-12"/>
				<Height val="26"/>
				<Toggled val="false"/>
				<Tooltip val="@Sinonis/Menu/Tip/Chat"/>
				<Frame type="Button" name="Button">
					<Width val="22"/>
					<Height val="22"/>
				</Frame>
				<Frame type="Image" name="ShownMark">
					<Anchor relative="$parent/Button"/>
					<Texture val="@UI/Storm_Checkbox_CheckMark"/>
					<AcceptsMouse val="false"/>
				</Frame>
				<Frame type="Image" name="CheckImage">
					<Alpha val="0"/>
					<Animation name="Apply">
						<Event event="OnShown" action="DirectionForward,Play"/>
						<Event event="OnHidden" action="DirectionReverse,Play"/>
						<Controller type="Fade" end="Pause" frame="$parent/$parent/$parent/UIContainer/FullscreenUpperContainer/ChatDisplay">
							<Key type="Curve" time="0" value="255"/>
							<Key type="Curve" time="0.01" value="0"/>
						</Controller>
						<Controller type="Visibility" end="Pause" frame="$parent/ShownMark">
							<Key type="Bool" time="0" value="true"/>
							<Key type="Bool" time="0.01" value="false"/>
						</Controller>
					</Animation>
				</Frame>
				<Frame type="Label" name="Label">
					<Style val="SinonisCoreBarLabel"/>
					<Text val="@Sinonis/Menu/Chat"/>
				</Frame>
			</Frame>
			<Frame type="CheckBox" name="MenuReplay" template="_Sinonis/SinonisMenuRowTemplate">
				<Anchor side="Top" relative="$parent" pos="Min" offset="182"/>
				<Anchor side="Left" relative="$parent" pos="Min" offset="20"/>
				<Anchor side="Right" relative="$parent" pos="Max" offset="-12"/>
				<Height val="26"/>
				<Toggled val="false"/>
				<Tooltip val="@Sinonis/Menu/Tip/Replay"/>
				<Frame type="Button" name="Button">
