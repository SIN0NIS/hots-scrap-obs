	<!-- CC timer: the hero nameplate duration bar tracks the current CC and refills when a new one lands.
		Give it a remaining-time label and make it a bit taller so it is readable. -->
	<Frame type="UnitStatusDurationBar" name="HeroUnitStatusFrameNoEnergyTemplate/HeroUnitStatusParentFrame/DurationBar" file="UnitStatus">
		<VisibleToOwner val="true"/>
		<VisibleToAlly val="true"/>
		<VisibleToEnemy val="true"/>
		<Height val="6"/>
		<Frame type="Label" name="StatusBarLabel">
			<Anchor side="Top" relative="$parent" pos="Max" offset="1"/>
			<Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
			<Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
			<Unclipped val="true"/>
			<Style val="SinonisCCTimerLabel"/>
		</Frame>
	</Frame>
